# khipuchat environment template
# Run `khipu setup-env` for an interactive prompt loop that fills these in.
# Full acquisition details: docs/TOKENS.md

# --- Telegram ---
# Get these at https://my.telegram.org/apps (log in, "API development tools")
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE_NUMBER=
# auto-managed at first Telegram login -- do not set manually
TELEGRAM_SESSION_STRING=

# --- Discord ---
# Get this at https://discord.com/developers/applications (New Application > Bot > Reset Token)
DISCORD_TOKEN=

# --- Slack ---
# Get this at https://api.slack.com/apps (create app > OAuth & Permissions > Install to Workspace,
# copy the "User OAuth Token" starting with xoxp-)
SLACK_USER_TOKEN=

# --- Email/IMAP ---
# See docs/TOKENS.md; Gmail app password: https://myaccount.google.com/apppasswords
EMAIL_IMAP_HOST=
EMAIL_IMAP_USER=
EMAIL_IMAP_PASS=

# --- Beeper (Signal / Facebook Messenger) ---
# Get this from the Beeper Desktop app: Settings > Integrations > Approved connections
BEEPER_ACCESS_TOKEN=

# --- Security (optional) ---
# See docs/TOKENS.md and steering security-hardening notes; operator-chosen values.
# optional: SQLCipher passphrase
DB_KEY=
# optional: web basic-auth username
WEB_USER=
# optional: web basic-auth password
WEB_PASS=
# optional: MCP bearer token
MCP_SECRET=
